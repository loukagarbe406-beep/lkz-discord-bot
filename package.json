{
  "name": "lkz-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord LKZ+ — setup salons + pronos foot",
  "scripts": {
    "setup": "node setup.js",
    "start": "node bot.js",
    "register": "node register-commands.js",
    "pm2:start": "pm2 start bot.js --name lkz-discord-bot --time",
